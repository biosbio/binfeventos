// ===============================================
// Variáveis de ambiente — BINF EVENTOS
// Copiar para .env e preencher os valores locais.
// NUNCA comprometer .env no repositório (SEC-12).
// ===============================================

// Base de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/binf_eventos?schema=public"

// Seed (apenas ambiente local/dev)
ADMIN_EMAIL="admin@binf.local"
ADMIN_PASSWORD="ChangeMe!2026"

// Segredos de sessão (gerar com: openssl rand -base64 32)
SESSION_SECRET=""

// Prestador de pagamento (MVP: um prestador principal por mercado)
PAYMENT_PROVIDER_CODE=""

// Email transacional (ex: Resend, SES) — chave no gestor de segredos
EMAIL_API_KEY=""

// SMS (ex: Twilio, operadora local)
SMS_API_KEY=""

// URL da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
