# Copie para .env e preencha apenas no seu ambiente local/deploy.
# Nunca coloque credenciais reais neste ficheiro nem faça commit de .env.
# Para Neon, use a URL pooled em DATABASE_URL e a URL direta em
# DATABASE_URL_UNPOOLED (usada pelo Prisma nas migrations).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/binf_eventos?schema=public"

# Conta administrativa criada apenas se ainda não existir.
ADMIN_EMAIL="admin@example.invalid"
ADMIN_PASSWORD="CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD"
ADMIN_MFA_SECRET="GENERATE_A_BASE32_TOTP_SECRET"

# Segredos obrigatórios. Gere localmente; não os envie por chat.
SESSION_SECRET="GENERATE_WITH_openssl_rand_base64_32"
MFA_ENCRYPTION_KEY="64_HEXADECIMAL_CHARACTERS_FROM_openssl_rand_hex_32"
SANDBOX_WEBHOOK_SECRET="GENERATE_WITH_openssl_rand_hex_32"

PAYMENT_PROVIDER_CODE="sandbox"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

RESEND_API_KEY=""
EMAIL_FROM="BINF EVENTOS <no-reply@example.invalid>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
EMAIL_API_KEY=""
SMS_API_KEY=""
