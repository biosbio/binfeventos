generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Parte 1 — Fundação + Domínio 1: Utilizadores e Organizações
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  country    String    @default("AO")
  currency   String    @default("AOA")
  status     OrgStatus @default(ACTIVE)
  createdAt  DateTime  @default(now())

  memberships OrgMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  events      Event[]
  venues      Venue[]
  ticketTypes TicketType[]
  orders      Order[]
  payments    Payment[]
  refunds     Refund[]
  settlements Settlement[]
  ledgerEntries FinancialLedgerEntry[]
  reserves    FinancialReserve[]
  stations    BoxOfficeStation[]
  shifts      CashShift[]
  tickets     Ticket[]
  transferRequests TicketTransferRequest[]
  accessGates AccessGate[]
  accessEvents AccessEvent[]

  @@map("organizations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  mfaEnabled   Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  memberships OrgMembership[]
  sessions    Session[]
  orders      Order[]
  shifts      CashShift[]

  @@map("users")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  isSystem       Boolean @default(false)
  organizationId String? @db.Uuid

  memberships    OrgMembership[]

  @@unique([name, organizationId])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique
  domain String

  @@map("permissions")
}

model OrgMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  invitedAt      DateTime @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("org_memberships")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  deviceInfo     String?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization?  @relation(fields: [organizationId], references: [id])

  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

// ============================================================
// Parte 2 — Domínio 2: Eventos e Sessões
// ============================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  SOLD_OUT
  POSTPONED
  CANCELLED
  COMPLETED
  CLOSED
}

enum EventCategory {
  CONCERT
  CONFERENCE
  SPORT
  THEATER
  FESTIVAL
  WORKSHOP
  OTHER
}

model Venue {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  address        String?
  city           String?
  country        String  @default("AO")
  capacity       Int?
  mapUrl         String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  seatMaps     SeatMap[]
  stations     BoxOfficeStation[]
  gates        AccessGate[]

  @@map("venues")
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  slug           String
  name           String
  description    String?
  category       EventCategory @default(OTHER)
  coverImageUrl  String?
  responsibleUserId String?    @db.Uuid
  status         EventStatus  @default(DRAFT)
  entryRules     String?
  terms          String?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  ticketTypes  TicketType[]

  @@unique([organizationId, slug])
  @@map("events")
}

model EventSession {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  venueId      String?  @db.Uuid
  name         String?
  startsAt     DateTime
  endsAt       DateTime
  doorsOpenAt  DateTime?
  createdAt    DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id])
  venue Venue? @relation(fields: [venueId], references: [id])
  inventory TicketInventory[]
  holds      InventoryHold[]
  orders     Order[]
  tickets    Ticket[]

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

// ============================================================
// Parte 3 — Domínio 3: Bilhetes e Inventário
// ============================================================

enum TicketCategory {
  NORMAL
  VIP
  PREMIUM
  STUDENT
  CHILD
  FREE
  INVITE
  SPECIAL_ACCESS
}

enum TicketTypeStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model TicketType {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @db.Uuid
  organizationId String         @db.Uuid
  name           String
  category       TicketCategory @default(NORMAL)
  description    String?
  basePriceCents Int            @default(0)
  currency       String         @default("AOA")
  rules          Json?
  requiresIdentity Boolean      @default(true)
  status         TicketTypeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event          Event          @relation(fields: [eventId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  batches        TicketBatch[]
  inventory      TicketInventory[]
  holds          InventoryHold[]
  seats          Seat[]
  orderLines     OrderLine[]
  orderAttendees OrderAttendee[]
  tickets        Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

enum BatchStatus {
  SCHEDULED
  OPEN
  PAUSED
  CLOSED
  SOLD_OUT
}

model TicketBatch {
  id           String      @id @default(uuid()) @db.Uuid
  ticketTypeId String      @db.Uuid
  name         String
  quantity     Int
  priceCents   Int?
  startsAt     DateTime
  endsAt       DateTime
  maxPerBuyer  Int         @default(10)
  status       BatchStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  inventory  TicketInventory[]

  @@index([ticketTypeId, status])
  @@map("ticket_batches")
}

enum HoldStatus {
  AVAILABLE
  RESERVED
  PENDING_PAYMENT
  VERIFYING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model TicketInventory {
  id           String @id @default(uuid()) @db.Uuid
  sessionId    String @db.Uuid
  ticketTypeId String @db.Uuid
  batchId      String @db.Uuid

  totalQuantity     Int @default(0)
  reservedQuantity  Int @default(0)
  soldQuantity      Int @default(0)

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])
  batch      TicketBatch  @relation(fields: [batchId], references: [id])

  @@unique([sessionId, ticketTypeId, batchId])
  @@map("ticket_inventory")
}

model InventoryHold {
  id           String     @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  sessionId    String     @db.Uuid
  ticketTypeId String     @db.Uuid
  batchId      String     @db.Uuid
  status       HoldStatus @default(RESERVED)
  quantity     Int
  idempotencyKey String?  @unique
  expiresAt    DateTime
  releasedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])

  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("inventory_holds")
}

model SeatMap {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  venueId   String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  session EventSession @relation(fields: [sessionId], references: [id])
  venue   Venue        @relation(fields: [venueId], references: [id])
  seats   Seat[]

  @@unique([sessionId, venueId])
  @@map("seat_maps")
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

model Seat {
  id           String     @id @default(uuid()) @db.Uuid
  seatMapId    String     @db.Uuid
  ticketTypeId String?    @db.Uuid
  section      String
  row          String
  label        String
  status       SeatStatus @default(AVAILABLE)
  holdId       String?    @db.Uuid
  expiresAt    DateTime?

  seatMap    SeatMap     @relation(fields: [seatMapId], references: [id])
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  @@unique([seatMapId, section, row, label])
  @@index([seatMapId, status])
  @@map("seats")
}

// ============================================================
// Parte 4 — Domínio 4: Venda e Checkout
// ============================================================

enum OrderStatus {
  DRAFT
  RESERVED
  PENDING_PAYMENT
  UNDER_REVIEW
  CONFIRMED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum SalesChannel {
  MARKETPLACE
  ORGANIZER_PRIVATE
  BOX_OFFICE
  OTHER
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  orderNumber    String      @unique
  buyerUserId    String?     @db.Uuid
  buyerName      String
  buyerEmail     String
  buyerPhone     String?
  status         OrderStatus @default(DRAFT)
  channel        SalesChannel @default(MARKETPLACE)
  subtotalCents  Int         @default(0)
  discountCents  Int         @default(0)
  serviceFeeCents Int        @default(0)
  taxCents       Int         @default(0)
  commissionCents Int        @default(0)
  totalCents     Int         @default(0)
  currency       String      @default("AOA")
  checkoutIdempotencyKey String? @unique
  holdId         String?    @db.Uuid
  sessionId      String?    @db.Uuid
  expiresAt      DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  buyer        User?        @relation(fields: [buyerUserId], references: [id])
  session      EventSession? @relation(fields: [sessionId], references: [id])
  lines        OrderLine[]
  attendees    OrderAttendee[]
  payments     Payment[]
  refunds      Refund[]
  shiftId      String?     @db.Uuid
  tickets      Ticket[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("orders")
}

model OrderLine {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  ticketTypeId String   @db.Uuid
  batchId      String   @db.Uuid
  quantity     Int
  unitPriceCents Int
  lineSubtotalCents Int
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

model OrderAttendee {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  ticketTypeId String   @db.Uuid
  fullName    String
  email       String?
  phone       String?
  documentType String?
  documentNumber String?
  extraData   Json?
  createdAt   DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_attendees")
}

// ============================================================
// Parte 5 — Domínio 5: Pagamentos e Finanças
// ============================================================

enum PaymentMethodType {
  CARD
  MOBILE_MONEY
  DIGITAL_WALLET
  BANK_TRANSFER
  CASH
}

model PaymentProvider {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  country     String
  isActive    Boolean @default(true)
  adapterConfig Json?
  createdAt   DateTime @default(now())

  payments    Payment[]

  @@map("payment_providers")
}

enum PaymentStatus {
  CREATED
  INITIATED
  AWAITING_AUTHORIZATION
  PROCESSING
  CONFIRMED
  DECLINED
  CANCELLED
  EXPIRED
  UNDER_REVIEW
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  orderId          String        @db.Uuid
  providerId       String        @db.Uuid
  method           PaymentMethodType
  status           PaymentStatus @default(CREATED)
  amountCents      Int
  currency         String        @default("AOA")
  providerRef      String?
  providerRawPayload Json?
  confirmedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  order        Order           @relation(fields: [orderId], references: [id])
  provider     PaymentProvider @relation(fields: [providerId], references: [id])
  attempts     PaymentAttempt[]

  @@index([orderId, status])
  @@index([providerRef])
  @@map("payments")
}

enum AttemptStatus {
  ACTIVE
  BLOCKED
  COMPLETED
  FAILED
}

model PaymentAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  paymentId      String        @db.Uuid
  attemptNumber  Int
  status         AttemptStatus @default(ACTIVE)
  idempotencyKey String?       @unique
  providerRef    String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  notes          String?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, attemptNumber])
  @@map("payment_attempts")
}

enum RefundStatus {
  REQUESTED
  UNDER_ANALYSIS
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  orderId        String       @db.Uuid
  paymentId      String       @db.Uuid
  amountCents    Int
  reason         String
  status         RefundStatus @default(REQUESTED)
  approvedByUserId String?    @db.Uuid
  requestedByUserId String?   @db.Uuid
  providerRef    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id])
  payment      Payment       @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

enum ChargebackStatus {
  NOTIFIED
  EVIDENCE_GATHERING
  SUBMITTED
  WON
  LOST
}

model Chargeback {
  id            String           @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  paymentId     String           @db.Uuid
  providerRef   String?
  amountCents   Int
  deadlineAt    DateTime?
  status        ChargebackStatus @default(NOTIFIED)
  decisionNotes String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("chargebacks")
}

enum SettlementStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Settlement {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  grossCents     Int              @default(0)
  commissionCents Int             @default(0)
  providerFeeCents Int            @default(0)
  refundedCents   Int             @default(0)
  chargebackCents Int             @default(0)
  netCents       Int              @default(0)
  reservedCents  Int              @default(0)
  payableCents   Int              @default(0)
  status         SettlementStatus @default(PENDING)
  preparedByUserId  String?      @db.Uuid
  approvedByUserId  String?      @db.Uuid
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("settlements")
}

enum ReserveStatus {
  ACTIVE
  PARTIALLY_RELEASED
  RELEASED
}

model FinancialReserve {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  settlementId  String?       @db.Uuid
  reason         String
  amountCents    Int
  status         ReserveStatus @default(ACTIVE)
  releaseConditions String?
  releasedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("financial_reserves")
}

enum LedgerEntryType {
  SALE
  PAYMENT
  COMMISSION
  PROVIDER_FEE
  REFUND
  CHARGEBACK
  SETTLEMENT
  RESERVE
  RESERVE_RELEASE
  DEPOSIT
  CASH_DIFFERENCE
  ADJUSTMENT
}

model FinancialLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  type           LedgerEntryType
  amountCents    Int
  currency       String          @default("AOA")
  orderId        String?         @db.Uuid
  paymentId      String?         @db.Uuid
  settlementId   String?         @db.Uuid
  refundId       String?         @db.Uuid
  description    String?
  compensatesEntryId String?     @db.Uuid
  approvedByUserId  String?      @db.Uuid
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([orderId])
  @@map("financial_ledger_entries")
}

// ============================================================
// Parte 6 — Domínio 6: Bilheteira Física
// ============================================================

enum StationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model BoxOfficeStation {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  venueId        String?       @db.Uuid
  code           String
  name           String
  status         StationStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  venue        Venue?        @relation(fields: [venueId], references: [id])
  shifts       CashShift[]

  @@unique([organizationId, code])
  @@map("box_office_stations")
}

enum ShiftStatus {
  OPEN
  CLOSING
  CLOSED
  RECONCILED
}

model CashShift {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  stationId       String     @db.Uuid
  operatorUserId  String     @db.Uuid
  status          ShiftStatus @default(OPEN)
  openedAt        DateTime   @default(now())
  openedAtLocal   DateTime
  openingFloatCents Int      @default(0)
  totalSalesCents Int       @default(0)
  totalRefundsCents Int     @default(0)
  expectedCents   Int       @default(0)
  countedCents     Int?
  differenceCents  Int?
  closedAt        DateTime?
  closedByUserId  String?   @db.Uuid
  differenceNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  station      BoxOfficeStation @relation(fields: [stationId], references: [id])
  operator     User             @relation(fields: [operatorUserId], references: [id])
  orders       Order[]

  @@index([organizationId, status])
  @@map("cash_shifts")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  REFUND_PAID
}

model CashMovement {
  id            String          @id @default(uuid()) @db.Uuid
  shiftId       String          @db.Uuid
  type          CashMovementType
  amountCents   Int
  reason        String
  authorizedByUserId String?    @db.Uuid
  createdAt     DateTime        @default(now())

  shift CashShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@map("cash_movements")
}

enum CashDepositStatus {
  COUNTED
  HANDED_OVER
  DEPOSITED
  CONFIRMED
}

model CashDeposit {
  id          String            @id @default(uuid()) @db.Uuid
  shiftId     String            @db.Uuid
  amountCents Int
  status      CashDepositStatus @default(COUNTED)
  handedToUserId String?       @db.Uuid
  depositedAt DateTime?
  bankReference String?
  confirmedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  shift CashShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@map("cash_deposits")
}

// ============================================================
// Parte 7 — Domínio 7: Controlo de Acesso
// ============================================================

// Estado do bilhete emitido (doc. mestra, secção 14)
enum TicketStatus {
  ISSUED      // emitido, válido para entrada
  USED        // utilizado (entrada validada)
  TRANSFERRED // titularidade transferida (QR anterior invalidado)
  CANCELLED   // cancelado (evento cancelado, reembolso, fraude)
  EXPIRED     // expirado (sessão realizada sem utilização)
  REVOKED     // revogado administrativamente
}

// Bilhete digital: identificador único, QR individual, titular identificado.
// Emissão APENAS após confirmação válida do pagamento (idempotente).
model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  orderId        String       @db.Uuid
  sessionId      String       @db.Uuid
  ticketTypeId   String       @db.Uuid
  orderAttendeeId String?     @db.Uuid // titular identificado
  seatId         String?     @db.Uuid // lugar numerado, quando aplicável
  ticketNumber   String       @unique // identificador único legível
  status         TicketStatus @default(ISSUED)
  // Segredo do QR: hash do token imprevisível; o token plano nunca é guardado
  qrSecretHash   String       @unique
  qrIssuedAt     DateTime     @default(now())
  qrRotatedAt    DateTime?    // última rotação (transferência)
  // Reentrada: quando permitido pelo evento
  reentryAllowed Boolean      @default(false)
  entryCount     Int          @default(0)
  lastExitAt     DateTime?
  issuedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id])
  session      EventSession  @relation(fields: [sessionId], references: [id])
  ticketType   TicketType    @relation(fields: [ticketTypeId], references: [id])
  accessEvents AccessEvent[]

  @@index([orderId])
  @@index([sessionId, status])
  @@map("tickets")
}

// Transferência controlada de bilhetes (doc. mestra, secção 13)
enum TransferStatus {
  REQUESTED      // solicitação pelo titular
  ELIGIBILITY_CHECK
  AWAITING_CONFIRMATION // confirmação quando aplicável
  COMPLETED      // titularidade atualizada + novo QR emitido
  REJECTED       // sem elegibilidade ou fora dos prazos
  CANCELLED
}

model TicketTransferRequest {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  ticketId       String         @db.Uuid
  requesterUserId String?       @db.Uuid // titular atual (se autenticado)
  // Dados do NOVO titular (identificação obrigatória)
  newHolderFullName String
  newHolderEmail    String?
  newHolderPhone    String?
  newHolderDocumentType String?
  newHolderDocumentNumber String?
  status         TransferStatus @default(REQUESTED)
  rejectionReason String?
  reviewedByUserId String?      @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  ticket       Ticket       @relation(fields: [ticketId], references: [id])

  @@index([organizationId, status])
  @@map("ticket_transfer_requests")
}

// Porta/ponto de acesso físico (validadores)
enum GateType {
  ENTRY       // entrada
  EXIT        // saída
  REENTRY     // reentrada
}

model AccessGate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  venueId        String    @db.Uuid
  sessionId      String?   @db.Uuid // gate dedicado a uma sessão (opcional)
  code            String   // ex: "PORTA-A"
  name            String
  gateType        GateType  @default(ENTRY)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  venue        Venue         @relation(fields: [venueId], references: [id])
  accessEvents AccessEvent[]

  @@unique([organizationId, code])
  @@map("access_gates")
}

// Registo de movimento: entrada, saída, reentrada e tentativas recusadas
enum AccessEventType {
  ENTRY_GRANTED
  ENTRY_DENIED
  EXIT_RECORDED
  REENTRY_GRANTED
  REENTRY_DENIED
}

enum DenialReason {
  INVALID_QR        // QR inválido, expirado ou revogado
  ALREADY_USED      // bilhete já utilizado
  WRONG_SESSION     // bilhete de outra sessão
  TICKET_CANCELLED
  TICKET_REVOKED
  IDENTITY_MISMATCH // titular não confere com identificação
  NOT_EVENT_DAY     // fora do horário de abertura
  GATE_CLOSED
}

model AccessEvent {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  ticketId       String?         @db.Uuid // null = tentativa com QR irreconhecível
  gateId         String          @db.Uuid
  eventType      AccessEventType
  denialReason   DenialReason?
  qrPayloadHash  String?         // hash do QR apresentado (evidência, nunca o segredo)
  validatorUserId String?        @db.Uuid // operador do validador
  identityVerified Boolean       @default(false) // conferência de identidade
  occurredAt     DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])
  gate         AccessGate  @relation(fields: [gateId], references: [id])

  @@index([organizationId, occurredAt])
  @@index([ticketId])
  @@map("access_events")
}
