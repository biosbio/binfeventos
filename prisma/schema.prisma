generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Parte 1 — Fundação + Domínio 1: Utilizadores e Organizações
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  country    String    @default("AO")
  currency   String    @default("AOA")
  status     OrgStatus @default(ACTIVE)
  createdAt  DateTime  @default(now())

  memberships OrgMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  events      Event[]
  venues      Venue[]
  ticketTypes TicketType[]
  orders      Order[]
  payments    Payment[]
  refunds     Refund[]
  settlements Settlement[]
  ledgerEntries FinancialLedgerEntry[]
  reserves    FinancialReserve[]

  @@map("organizations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  mfaEnabled   Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  memberships OrgMembership[]
  sessions    Session[]
  orders      Order[]

  @@map("users")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  isSystem       Boolean @default(false)
  organizationId String? @db.Uuid

  memberships    OrgMembership[]

  @@unique([name, organizationId])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique
  domain String

  @@map("permissions")
}

model OrgMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  invitedAt      DateTime @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("org_memberships")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  deviceInfo     String?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization?  @relation(fields: [organizationId], references: [id])

  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

// ============================================================
// Parte 2 — Domínio 2: Eventos e Sessões
// ============================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  SOLD_OUT
  POSTPONED
  CANCELLED
  COMPLETED
  CLOSED
}

enum EventCategory {
  CONCERT
  CONFERENCE
  SPORT
  THEATER
  FESTIVAL
  WORKSHOP
  OTHER
}

model Venue {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  address        String?
  city           String?
  country        String  @default("AO")
  capacity       Int?
  mapUrl         String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  seatMaps     SeatMap[]

  @@map("venues")
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  slug           String
  name           String
  description    String?
  category       EventCategory @default(OTHER)
  coverImageUrl  String?
  responsibleUserId String?    @db.Uuid
  status         EventStatus  @default(DRAFT)
  entryRules     String?
  terms          String?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  ticketTypes  TicketType[]

  @@unique([organizationId, slug])
  @@map("events")
}

model EventSession {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  venueId      String?  @db.Uuid
  name         String?
  startsAt     DateTime
  endsAt       DateTime
  doorsOpenAt  DateTime?
  createdAt    DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id])
  venue Venue? @relation(fields: [venueId], references: [id])
  inventory TicketInventory[]
  holds      InventoryHold[]
  orders     Order[]

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

// ============================================================
// Parte 3 — Domínio 3: Bilhetes e Inventário
// ============================================================

enum TicketCategory {
  NORMAL
  VIP
  PREMIUM
  STUDENT
  CHILD
  FREE
  INVITE
  SPECIAL_ACCESS
}

enum TicketTypeStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model TicketType {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @db.Uuid
  organizationId String         @db.Uuid
  name           String
  category       TicketCategory @default(NORMAL)
  description    String?
  basePriceCents Int            @default(0)
  currency       String         @default("AOA")
  rules          Json?
  requiresIdentity Boolean      @default(true)
  status         TicketTypeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event          Event          @relation(fields: [eventId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  batches        TicketBatch[]
  inventory      TicketInventory[]
  holds          InventoryHold[]
  seats          Seat[]
  orderLines     OrderLine[]
  orderAttendees OrderAttendee[]

  @@index([eventId])
  @@map("ticket_types")
}

enum BatchStatus {
  SCHEDULED
  OPEN
  PAUSED
  CLOSED
  SOLD_OUT
}

model TicketBatch {
  id           String      @id @default(uuid()) @db.Uuid
  ticketTypeId String      @db.Uuid
  name         String
  quantity     Int
  priceCents   Int?
  startsAt     DateTime
  endsAt       DateTime
  maxPerBuyer  Int         @default(10)
  status       BatchStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  inventory  TicketInventory[]

  @@index([ticketTypeId, status])
  @@map("ticket_batches")
}

enum HoldStatus {
  AVAILABLE
  RESERVED
  PENDING_PAYMENT
  VERIFYING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model TicketInventory {
  id           String @id @default(uuid()) @db.Uuid
  sessionId    String @db.Uuid
  ticketTypeId String @db.Uuid
  batchId      String @db.Uuid

  totalQuantity     Int @default(0)
  reservedQuantity  Int @default(0)
  soldQuantity      Int @default(0)

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])
  batch      TicketBatch  @relation(fields: [batchId], references: [id])

  @@unique([sessionId, ticketTypeId, batchId])
  @@map("ticket_inventory")
}

model InventoryHold {
  id           String     @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  sessionId    String     @db.Uuid
  ticketTypeId String     @db.Uuid
  batchId      String     @db.Uuid
  status       HoldStatus @default(RESERVED)
  quantity     Int
  idempotencyKey String?  @unique
  expiresAt    DateTime
  releasedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])

  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("inventory_holds")
}

model SeatMap {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  venueId   String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  session EventSession @relation(fields: [sessionId], references: [id])
  venue   Venue        @relation(fields: [venueId], references: [id])
  seats   Seat[]

  @@unique([sessionId, venueId])
  @@map("seat_maps")
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

model Seat {
  id           String     @id @default(uuid()) @db.Uuid
  seatMapId    String     @db.Uuid
  ticketTypeId String?    @db.Uuid
  section      String
  row          String
  label        String
  status       SeatStatus @default(AVAILABLE)
  holdId       String?    @db.Uuid
  expiresAt    DateTime?

  seatMap    SeatMap     @relation(fields: [seatMapId], references: [id])
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  @@unique([seatMapId, section, row, label])
  @@index([seatMapId, status])
  @@map("seats")
}

// ============================================================
// Parte 4 — Domínio 4: Venda e Checkout
// ============================================================

enum OrderStatus {
  DRAFT
  RESERVED
  PENDING_PAYMENT
  UNDER_REVIEW
  CONFIRMED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum SalesChannel {
  MARKETPLACE
  ORGANIZER_PRIVATE
  BOX_OFFICE
  OTHER
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  orderNumber    String      @unique
  buyerUserId    String?     @db.Uuid
  buyerName      String
  buyerEmail     String
  buyerPhone     String?
  status         OrderStatus @default(DRAFT)
  channel        SalesChannel @default(MARKETPLACE)
  subtotalCents  Int         @default(0)
  discountCents  Int         @default(0)
  serviceFeeCents Int        @default(0)
  taxCents       Int         @default(0)
  commissionCents Int        @default(0)
  totalCents     Int         @default(0)
  currency       String      @default("AOA")
  checkoutIdempotencyKey String? @unique
  holdId         String?    @db.Uuid
  sessionId      String?    @db.Uuid
  expiresAt      DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  buyer        User?        @relation(fields: [buyerUserId], references: [id])
  session      EventSession? @relation(fields: [sessionId], references: [id])
  lines        OrderLine[]
  attendees    OrderAttendee[]
  payments     Payment[]
  refunds      Refund[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("orders")
}

model OrderLine {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  ticketTypeId String   @db.Uuid
  batchId      String   @db.Uuid
  quantity     Int
  unitPriceCents Int
  lineSubtotalCents Int
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

model OrderAttendee {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  ticketTypeId String   @db.Uuid
  fullName    String
  email       String?
  phone       String?
  documentType String?
  documentNumber String?
  extraData   Json?
  createdAt   DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_attendees")
}

// ============================================================
// Parte 5 — Domínio 5: Pagamentos e Finanças
// ============================================================

// Métodos de pagamento suportados (doc. mestra: cartões, Mobile Money,
// carteiras digitais, transferências, dinheiro na bilheteira física)
enum PaymentMethodType {
  CARD
  MOBILE_MONEY
  DIGITAL_WALLET
  BANK_TRANSFER
  CASH
}

// Prestador de pagamento por mercado (adaptadores substituíveis)
model PaymentProvider {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // ex: "stripe", "multicaixa"
  name        String
  country     String
  isActive    Boolean @default(true)
  // Configuração normalizada do adaptador (chaves via gestor de segredos)
  adapterConfig Json?
  createdAt   DateTime @default(now())

  payments    Payment[]

  @@map("payment_providers")
}

// Estados do pagamento (doc. mestra, Parte 3, secção 2)
enum PaymentStatus {
  CREATED
  INITIATED
  AWAITING_AUTHORIZATION
  PROCESSING
  CONFIRMED
  DECLINED
  CANCELLED
  EXPIRED
  UNDER_REVIEW
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

// Pagamento: uma encomenda pode ter múltiplas tentativas controladas
// (Decisão aprovada — Opção B), mas apenas uma confirmação válida.
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  orderId          String        @db.Uuid
  providerId       String        @db.Uuid
  method           PaymentMethodType
  status           PaymentStatus @default(CREATED)
  amountCents      Int
  currency         String        @default("AOA")
  providerRef      String?       // identificador normalizado da transação no prestador
  providerRawPayload Json?       // payload/webhook bruto (evidência)
  confirmedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  order        Order           @relation(fields: [orderId], references: [id])
  provider     PaymentProvider @relation(fields: [providerId], references: [id])
  attempts     PaymentAttempt[]

  @@index([orderId, status])
  @@index([providerRef])
  @@map("payments")
}

// Nova tentativa de pagamento (Opção B): id único, mesma encomenda,
// histórico preservado, sem cobranças duplicadas.
enum AttemptStatus {
  ACTIVE      // tentativa em curso; se confirmada, as restantes são bloqueadas
  BLOCKED     // bloqueada porque outra tentativa foi confirmada
  COMPLETED   // tentativa que resultou em confirmação
  FAILED
}

model PaymentAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  paymentId      String        @db.Uuid
  attemptNumber  Int
  status         AttemptStatus @default(ACTIVE)
  idempotencyKey String?       @unique
  providerRef    String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  notes          String?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, attemptNumber])
  @@map("payment_attempts")
}

// Reembolsos: totais e parciais, com rastreabilidade
enum RefundStatus {
  REQUESTED
  UNDER_ANALYSIS
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  orderId        String       @db.Uuid
  paymentId      String       @db.Uuid
  amountCents    Int
  reason         String
  status         RefundStatus @default(REQUESTED)
  approvedByUserId String?    @db.Uuid // segregação: quem solicita ≠ quem aprova
  requestedByUserId String?   @db.Uuid
  providerRef    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id])
  payment      Payment       @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

// Chargeback: contestação pelo titular do meio de pagamento
enum ChargebackStatus {
  NOTIFIED
  EVIDENCE_GATHERING
  SUBMITTED
  WON
  LOST
}

model Chargeback {
  id            String           @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  paymentId     String           @db.Uuid
  providerRef   String?
  amountCents   Int
  deadlineAt    DateTime? // prazo de resposta do prestador
  status        ChargebackStatus @default(NOTIFIED)
  decisionNotes String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("chargebacks")
}

// Liquidação: disponibilização dos valores devidos ao organizador
enum SettlementStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Settlement {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  grossCents     Int              @default(0) // vendas brutas
  commissionCents Int             @default(0) // receita da plataforma
  providerFeeCents Int            @default(0) // taxas do prestador
  refundedCents   Int             @default(0) // reembolsos
  chargebackCents Int             @default(0) // contestações
  netCents       Int              @default(0) // valor líquido
  reservedCents  Int              @default(0) // retido em reserva
  payableCents   Int              @default(0) // saldo disponível a liquidar
  status         SettlementStatus @default(PENDING)
  preparedByUserId  String?      @db.Uuid
  approvedByUserId  String?      @db.Uuid // dupla aprovação
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("settlements")
}

// Reservas financeiras baseadas no risco
enum ReserveStatus {
  ACTIVE
  PARTIALLY_RELEASED
  RELEASED
}

model FinancialReserve {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  settlementId  String?       @db.Uuid
  reason         String
  amountCents    Int
  status         ReserveStatus @default(ACTIVE)
  releaseConditions String?
  releasedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("financial_reserves")
}

// Livro-razão financeiro: histórico IMUTÁVEL.
// Nunca apagar/sobrescrever lançamentos confirmados; correções = lançamentos
// compensatórios. Registos mínimos exigidos pela doc. mestra, secção 11.
enum LedgerEntryType {
  SALE
  PAYMENT
  COMMISSION
  PROVIDER_FEE
  REFUND
  CHARGEBACK
  SETTLEMENT
  RESERVE
  RESERVE_RELEASE
  DEPOSIT
  CASH_DIFFERENCE
  ADJUSTMENT
}

model FinancialLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  type           LedgerEntryType
  amountCents    Int             // positivo (débito) / negativo (crédito)
  currency       String          @default("AOA")
  orderId        String?         @db.Uuid
  paymentId      String?         @db.Uuid
  settlementId   String?         @db.Uuid
  refundId       String?         @db.Uuid
  description    String?
  // Entradas compensatórias referenciam o lançamento original
  compensatesEntryId String?     @db.Uuid
  approvedByUserId  String?      @db.Uuid
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([orderId])
  @@map("financial_ledger_entries")
}
