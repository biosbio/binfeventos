generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Parte 1 — Fundação + Domínio 1: Utilizadores e Organizações
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  country    String    @default("AO")
  currency   String    @default("AOA")
  status     OrgStatus @default(ACTIVE)
  createdAt  DateTime  @default(now())

  memberships OrgMembership[]
  boxOfficeSellerInvites BoxOfficeSellerInvite[]
  sessions    Session[]
  auditLogs   AuditLog[]
  events      Event[]
  venues      Venue[]
  ticketTypes TicketType[]
  orders      Order[]
  payments    Payment[]
  refunds     Refund[]
  settlements Settlement[]
  ledgerEntries FinancialLedgerEntry[]
  reserves    FinancialReserve[]
  stations    BoxOfficeStation[]
  shifts      CashShift[]
  tickets     Ticket[]
  transferRequests TicketTransferRequest[]
  accessGates AccessGate[]
  accessEvents AccessEvent[]
  fraudRules  FraudRule[]
  fraudAlerts FraudAlert[]
  incidents   SecurityIncident[]
  notifications Notification[]
  saasSubscriptions SaasSubscription[]
  dataExports DataExport[]

  @@map("organizations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  mfaEnabled   Boolean    @default(false)
  // Segredo TOTP (Base32). Em produção, encriptar em repouso (SEC-07).
  mfaSecret    String?
  status       UserStatus @default(ACTIVE)
  platformRole PlatformRole @default(USER)
  createdAt    DateTime   @default(now())

  memberships OrgMembership[]
  createdBoxOfficeSellerInvites BoxOfficeSellerInvite[] @relation("BoxOfficeSellerInviteCreator")
  createdEventStaffInvites EventStaffInvite[] @relation("EventStaffInviteCreator")
  eventStaffMemberships EventStaffMembership[]
  sessions    Session[]
  panelVerificationCodes PanelVerificationCode[]
  passwordResetCodes PasswordResetCode[]
  orders      Order[]
  shifts      CashShift[]

  @@map("users")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  isSystem       Boolean @default(false)
  organizationId String? @db.Uuid

  memberships    OrgMembership[]
  rolePermissions RolePermission[]

  @@unique([name, organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  domain      String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Junção Role N-N Permission (SEC-02: RBAC/ABAC)
model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model OrgMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  invitedAt      DateTime @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("org_memberships")
}

model BoxOfficeSellerInvite {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  createdByUserId String    @db.Uuid
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("BoxOfficeSellerInviteCreator", fields: [createdByUserId], references: [id])

  @@index([organizationId, expiresAt])
  @@map("box_office_seller_invites")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  panelVerifiedUntil DateTime?
  deviceInfo     String?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization?  @relation(fields: [organizationId], references: [id])

  @@map("sessions")
}


model PanelVerificationCode {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  codeHash    String
  channel     VerificationChannel
  expiresAt   DateTime
  attempts    Int                @default(0)
  consumedAt  DateTime?
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("panel_verification_codes")
}

model PasswordResetCode {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  codeHash   String
  channel    VerificationChannel
  expiresAt  DateTime
  attempts   Int                @default(0)
  consumedAt DateTime?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_codes")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

// ============================================================
// Parte 2 — Domínio 2: Eventos e Sessões
// ============================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  SOLD_OUT
  POSTPONED
  CANCELLED
  COMPLETED
  CLOSED
}

enum EventCategory {
  CONCERT
  CONFERENCE
  SPORT
  THEATER
  FESTIVAL
  WORKSHOP
  OTHER
}

model Venue {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  address        String?
  city           String?
  country        String  @default("AO")
  capacity       Int?
  mapUrl         String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  seatMaps     SeatMap[]
  stations     BoxOfficeStation[]
  gates        AccessGate[]

  @@map("venues")
}

enum EventStaffRole {
  SELLER
  GATE
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  slug           String
  name           String
  description    String?
  category       EventCategory @default(OTHER)
  coverImageUrl  String?
  responsibleUserId String?    @db.Uuid
  status         EventStatus  @default(DRAFT)
  entryRules     String?
  terms          String?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  ticketTypes  TicketType[]
  staffInvites EventStaffInvite[]
  staffMembers EventStaffMembership[]
  cashShifts   CashShift[]

  @@unique([organizationId, slug])
  @@map("events")
}

model EventStaffInvite {
  id              String         @id @default(uuid()) @db.Uuid
  eventId         String         @db.Uuid
  createdByUserId String         @db.Uuid
  role            EventStaffRole
  tokenHash       String         @unique
  createdAt       DateTime       @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  event     Event @relation(fields: [eventId], references: [id])
  createdBy User  @relation("EventStaffInviteCreator", fields: [createdByUserId], references: [id])
  members   EventStaffMembership[]

  @@index([eventId, expiresAt])
  @@map("event_staff_invites")
}

model EventStaffMembership {
  id         String         @id @default(uuid()) @db.Uuid
  eventId    String         @db.Uuid
  userId     String         @db.Uuid
  inviteId   String?        @db.Uuid
  role       EventStaffRole
  invitedAt  DateTime       @default(now())
  approvedAt DateTime?

  event  Event             @relation(fields: [eventId], references: [id])
  user   User              @relation(fields: [userId], references: [id])
  invite EventStaffInvite? @relation(fields: [inviteId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId, role, approvedAt])
  @@map("event_staff_memberships")
}

model EventSession {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  venueId      String?  @db.Uuid
  name         String?
  startsAt     DateTime
  endsAt       DateTime
  doorsOpenAt  DateTime?
  createdAt    DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id])
  venue Venue? @relation(fields: [venueId], references: [id])
  inventory TicketInventory[]
  holds      InventoryHold[]
  orders     Order[]
  tickets    Ticket[]
  seatMaps   SeatMap[]

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

// ============================================================
// Parte 3 — Domínio 3: Bilhetes e Inventário
// ============================================================

enum TicketCategory {
  NORMAL
  VIP
  PREMIUM
  STUDENT
  CHILD
  FREE
  INVITE
  SPECIAL_ACCESS
}

enum TicketTypeStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model TicketType {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @db.Uuid
  organizationId String         @db.Uuid
  name           String
  category       TicketCategory @default(NORMAL)
  description    String?
  basePriceCents Int            @default(0)
  currency       String         @default("AOA")
  rules          Json?
  requiresIdentity Boolean      @default(true)
  status         TicketTypeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event          Event          @relation(fields: [eventId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  batches        TicketBatch[]
  inventory      TicketInventory[]
  holds          InventoryHold[]
  seats          Seat[]
  orderLines     OrderLine[]
  orderAttendees OrderAttendee[]
  tickets        Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

enum BatchStatus {
  SCHEDULED
  OPEN
  PAUSED
  CLOSED
  SOLD_OUT
}

model TicketBatch {
  id           String      @id @default(uuid()) @db.Uuid
  ticketTypeId String      @db.Uuid
  name         String
  quantity     Int
  priceCents   Int?
  startsAt     DateTime?
  endsAt       DateTime?
  maxPerBuyer  Int         @default(10)
  status       BatchStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  inventory  TicketInventory[]

  @@index([ticketTypeId, status])
  @@map("ticket_batches")
}

enum HoldStatus {
  AVAILABLE
  RESERVED
  PENDING_PAYMENT
  VERIFYING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model TicketInventory {
  id           String @id @default(uuid()) @db.Uuid
  sessionId    String @db.Uuid
  ticketTypeId String @db.Uuid
  batchId      String @db.Uuid

  totalQuantity     Int @default(0)
  reservedQuantity  Int @default(0)
  soldQuantity      Int @default(0)

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])
  batch      TicketBatch  @relation(fields: [batchId], references: [id])

  @@unique([sessionId, ticketTypeId, batchId])
  @@map("ticket_inventory")
}

model InventoryHold {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  userId         String?    @db.Uuid
  sessionId      String     @db.Uuid
  ticketTypeId   String     @db.Uuid
  batchId        String     @db.Uuid
  status         HoldStatus @default(RESERVED)
  quantity       Int
  idempotencyKey String?    @unique
  expiresAt      DateTime
  releasedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])

  @@index([sessionId, status])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("inventory_holds")
}

model SeatMap {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  venueId   String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  session EventSession @relation(fields: [sessionId], references: [id])
  venue   Venue        @relation(fields: [venueId], references: [id])
  seats   Seat[]

  @@unique([sessionId, venueId])
  @@map("seat_maps")
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

model Seat {
  id           String     @id @default(uuid()) @db.Uuid
  seatMapId    String     @db.Uuid
  ticketTypeId String?    @db.Uuid
  section      String
  row          String
  label        String
  status       SeatStatus @default(AVAILABLE)
  holdId       String?    @db.Uuid
  expiresAt    DateTime?

  seatMap    SeatMap     @relation(fields: [seatMapId], references: [id])
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  @@unique([seatMapId, section, row, label])
  @@index([seatMapId, status])
  @@map("seats")
}

// ============================================================
// Parte 4 — Domínio 4: Venda e Checkout
// ============================================================

enum OrderStatus {
  DRAFT
  RESERVED
  PENDING_PAYMENT
  UNDER_REVIEW
  CONFIRMED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum SalesChannel {
  MARKETPLACE
  ORGANIZER_PRIVATE
  BOX_OFFICE
  OTHER
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  orderNumber    String      @unique
  buyerUserId    String?     @db.Uuid
  buyerName      String
  buyerEmail     String
  buyerPhone     String?
  status         OrderStatus @default(DRAFT)
  channel        SalesChannel @default(MARKETPLACE)
  subtotalCents  Int         @default(0)
  discountCents  Int         @default(0)
  serviceFeeCents Int        @default(0)
  taxCents       Int         @default(0)
  commissionCents Int        @default(0)
  totalCents     Int         @default(0)
  currency       String      @default("AOA")
  checkoutIdempotencyKey String? @unique
  holdId         String?    @db.Uuid
  sessionId      String?    @db.Uuid
  expiresAt      DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  buyer        User?        @relation(fields: [buyerUserId], references: [id])
  session      EventSession? @relation(fields: [sessionId], references: [id])
  lines        OrderLine[]
  attendees    OrderAttendee[]
  payments     Payment[]
  refunds      Refund[]
  shiftId      String?     @db.Uuid
  cashShift    CashShift?  @relation(fields: [shiftId], references: [id])
  tickets      Ticket[]
  fraudAlerts  FraudAlert[]
  notifications Notification[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("orders")
}

model OrderLine {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  ticketTypeId String   @db.Uuid
  batchId      String   @db.Uuid
  quantity     Int
  unitPriceCents Int
  lineSubtotalCents Int
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

model OrderAttendee {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  ticketTypeId String   @db.Uuid
  fullName    String
  email       String?
  phone       String?
  documentType String?
  documentNumber String?
  extraData   Json?
  createdAt   DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@map("order_attendees")
}

// ============================================================
// Parte 5 — Domínio 5: Pagamentos e Finanças
// ============================================================

enum PaymentMethodType {
  CARD
  MOBILE_MONEY
  DIGITAL_WALLET
  BANK_TRANSFER
  CASH
}

model PaymentProvider {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  country     String
  isActive    Boolean @default(true)
  adapterConfig Json?
  createdAt   DateTime @default(now())

  payments    Payment[]

  @@map("payment_providers")
}

enum PaymentStatus {
  CREATED
  INITIATED
  AWAITING_AUTHORIZATION
  PROCESSING
  CONFIRMED
  DECLINED
  CANCELLED
  EXPIRED
  UNDER_REVIEW
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  orderId          String        @db.Uuid
  providerId       String        @db.Uuid
  method           PaymentMethodType
  status           PaymentStatus @default(CREATED)
  amountCents      Int
  currency         String        @default("AOA")
  providerRef      String?
  providerRawPayload Json?
  confirmedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  order        Order           @relation(fields: [orderId], references: [id])
  provider     PaymentProvider @relation(fields: [providerId], references: [id])
  attempts     PaymentAttempt[]
  refunds      Refund[]
  chargebacks  Chargeback[]

  @@index([orderId, status])
  @@index([providerRef])
  @@map("payments")
}

enum AttemptStatus {
  ACTIVE
  BLOCKED
  COMPLETED
  FAILED
}

model PaymentAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  paymentId      String        @db.Uuid
  attemptNumber  Int
  status         AttemptStatus @default(ACTIVE)
  idempotencyKey String?       @unique
  providerRef    String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  notes          String?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, attemptNumber])
  @@map("payment_attempts")
}

enum RefundStatus {
  REQUESTED
  UNDER_ANALYSIS
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  orderId        String       @db.Uuid
  paymentId      String       @db.Uuid
  amountCents    Int
  reason         String
  status         RefundStatus @default(REQUESTED)
  approvedByUserId String?    @db.Uuid
  requestedByUserId String?   @db.Uuid
  providerRef    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id])
  payment      Payment       @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

enum ChargebackStatus {
  NOTIFIED
  EVIDENCE_GATHERING
  SUBMITTED
  WON
  LOST
}

model Chargeback {
  id            String           @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  paymentId     String           @db.Uuid
  providerRef   String?
  amountCents   Int
  deadlineAt    DateTime?
  status        ChargebackStatus @default(NOTIFIED)
  decisionNotes String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("chargebacks")
}

enum SettlementStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Settlement {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  grossCents     Int              @default(0)
  commissionCents Int             @default(0)
  providerFeeCents Int            @default(0)
  refundedCents   Int             @default(0)
  chargebackCents Int             @default(0)
  netCents       Int              @default(0)
  reservedCents  Int              @default(0)
  payableCents   Int              @default(0)
  status         SettlementStatus @default(PENDING)
  preparedByUserId  String?      @db.Uuid
  approvedByUserId  String?      @db.Uuid
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("settlements")
}

enum ReserveStatus {
  ACTIVE
  PARTIALLY_RELEASED
  RELEASED
}

model FinancialReserve {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  settlementId  String?       @db.Uuid
  reason         String
  amountCents    Int
  status         ReserveStatus @default(ACTIVE)
  releaseConditions String?
  releasedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("financial_reserves")
}

enum LedgerEntryType {
  SALE
  PAYMENT
  COMMISSION
  PROVIDER_FEE
  REFUND
  CHARGEBACK
  SETTLEMENT
  RESERVE
  RESERVE_RELEASE
  DEPOSIT
  CASH_DIFFERENCE
  ADJUSTMENT
}

model FinancialLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  type           LedgerEntryType
  amountCents    Int
  currency       String          @default("AOA")
  orderId        String?         @db.Uuid
  paymentId      String?         @db.Uuid
  settlementId   String?         @db.Uuid
  refundId       String?         @db.Uuid
  description    String?
  compensatesEntryId String?     @db.Uuid
  approvedByUserId  String?      @db.Uuid
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([orderId])
  @@unique([compensatesEntryId])
  @@map("financial_ledger_entries")
}

// ============================================================
// Parte 6 — Domínio 6: Bilheteira Física
// ============================================================

enum StationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model BoxOfficeStation {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  venueId        String?       @db.Uuid
  code           String
  name           String
  status         StationStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  venue        Venue?        @relation(fields: [venueId], references: [id])
  shifts       CashShift[]

  @@unique([organizationId, code])
  @@map("box_office_stations")
}

enum ShiftStatus {
  OPEN
  CLOSING
  CLOSED
  RECONCILED
}

model CashShift {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  eventId         String?    @db.Uuid
  stationId       String     @db.Uuid
  operatorUserId  String     @db.Uuid
  status          ShiftStatus @default(OPEN)
  openedAt        DateTime   @default(now())
  openedAtLocal   DateTime
  openingFloatCents Int      @default(0)
  totalSalesCents Int       @default(0)
  totalRefundsCents Int     @default(0)
  expectedCents   Int       @default(0)
  countedCents     Int?
  differenceCents  Int?
  closedAt        DateTime?
  closedByUserId  String?   @db.Uuid
  differenceNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  event        Event?           @relation(fields: [eventId], references: [id])
  station      BoxOfficeStation @relation(fields: [stationId], references: [id])
  operator     User             @relation(fields: [operatorUserId], references: [id])
  orders       Order[]
  movements    CashMovement[]
  deposits     CashDeposit[]

  @@index([organizationId, status])
  @@index([eventId, operatorUserId, status])
  @@map("cash_shifts")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  REFUND_PAID
}

model CashMovement {
  id            String          @id @default(uuid()) @db.Uuid
  shiftId       String          @db.Uuid
  type          CashMovementType
  amountCents   Int
  reason        String
  authorizedByUserId String?    @db.Uuid
  createdAt     DateTime        @default(now())

  shift CashShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@map("cash_movements")
}

enum CashDepositStatus {
  COUNTED
  HANDED_OVER
  DEPOSITED
  CONFIRMED
}

model CashDeposit {
  id          String            @id @default(uuid()) @db.Uuid
  shiftId     String            @db.Uuid
  amountCents Int
  status      CashDepositStatus @default(COUNTED)
  handedToUserId String?       @db.Uuid
  depositedAt DateTime?
  bankReference String?
  confirmedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  shift CashShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@map("cash_deposits")
}

// ============================================================
// Parte 7 — Domínio 7: Controlo de Acesso
// ============================================================

enum TicketStatus {
  ISSUED
  USED
  TRANSFERRED
  CANCELLED
  EXPIRED
  REVOKED
}

model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  orderId        String       @db.Uuid
  sessionId      String       @db.Uuid
  ticketTypeId   String       @db.Uuid
  orderAttendeeId String?     @db.Uuid
  holderUserId   String?      @db.Uuid
  holderEmail    String?
  holderName     String?
  seatId         String?     @db.Uuid
  ticketNumber   String       @unique
  status         TicketStatus @default(ISSUED)
  qrSecretHash   String       @unique
  qrIssuedAt     DateTime     @default(now())
  qrRotatedAt    DateTime?
  reentryAllowed Boolean      @default(false)
  entryCount     Int          @default(0)
  lastExitAt     DateTime?
  issuedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id])
  session      EventSession  @relation(fields: [sessionId], references: [id])
  ticketType   TicketType    @relation(fields: [ticketTypeId], references: [id])
  orderAttendee OrderAttendee? @relation(fields: [orderAttendeeId], references: [id])
  accessEvents AccessEvent[]
  transferRequests TicketTransferRequest[]

  @@index([orderId])
  @@index([sessionId, status])
  @@index([holderUserId, status])
  @@index([holderEmail, status])
  @@map("tickets")
}

enum TransferStatus {
  REQUESTED
  ELIGIBILITY_CHECK
  AWAITING_CONFIRMATION
  COMPLETED
  REJECTED
  CANCELLED
}

model TicketTransferRequest {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  ticketId       String         @db.Uuid
  requesterUserId String?       @db.Uuid
  newHolderFullName String
  newHolderEmail    String?
  newHolderPhone    String?
  newHolderDocumentType String?
  newHolderDocumentNumber String?
  status         TransferStatus @default(REQUESTED)
  rejectionReason String?
  reviewedByUserId String?      @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  ticket       Ticket       @relation(fields: [ticketId], references: [id])

  @@index([organizationId, status])
  @@map("ticket_transfer_requests")
}

enum GateType {
  ENTRY
  EXIT
  REENTRY
}

model AccessGate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  venueId        String    @db.Uuid
  sessionId      String?   @db.Uuid
  code            String
  name            String
  gateType        GateType  @default(ENTRY)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  venue        Venue         @relation(fields: [venueId], references: [id])
  accessEvents AccessEvent[]

  @@unique([organizationId, code])
  @@map("access_gates")
}

enum AccessEventType {
  ENTRY_GRANTED
  ENTRY_DENIED
  EXIT_RECORDED
  REENTRY_GRANTED
  REENTRY_DENIED
}

enum DenialReason {
  INVALID_QR
  ALREADY_USED
  WRONG_SESSION
  TICKET_CANCELLED
  TICKET_REVOKED
  IDENTITY_MISMATCH
  NOT_EVENT_DAY
  GATE_CLOSED
}

model AccessEvent {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  ticketId       String?         @db.Uuid
  gateId         String          @db.Uuid
  eventType      AccessEventType
  denialReason   DenialReason?
  qrPayloadHash  String?
  validatorUserId String?        @db.Uuid
  identityVerified Boolean       @default(false)
  occurredAt     DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])
  gate         AccessGate  @relation(fields: [gateId], references: [id])

  @@index([organizationId, occurredAt])
  @@index([ticketId])
  @@map("access_events")
}

// ============================================================
// Parte 8 — Domínio 8: Segurança e Antifraude
// ============================================================

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RuleAction {
  ALLOW
  REQUIRE_VERIFICATION
  BLOCK
  MANUAL_REVIEW
}

enum RuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model FraudRule {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  name           String
  description    String?
  condition      Json
  action         RuleAction
  riskLevel      RiskLevel
  status         RuleStatus @default(DRAFT)
  createdByUserId  String  @db.Uuid
  approvedByUserId String? @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  alerts      FraudAlert[]

  @@unique([organizationId, name])
  @@map("fraud_rules")
}

enum AlertStatus {
  OPEN
  IN_INVESTIGATION
  RESOLVED_FALSE_POSITIVE
  RESOLVED_CONFIRMED_FRAUD
  ACTION_TAKEN
}

model FraudAlert {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  ruleId         String      @db.Uuid
  orderId        String?     @db.Uuid
  riskLevel      RiskLevel
  status         AlertStatus @default(OPEN)
  evidence       Json
  investigatedByUserId String? @db.Uuid
  resolutionNotes String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  rule         FraudRule    @relation(fields: [ruleId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@index([organizationId, status])
  @@map("fraud_alerts")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  TRIAGED
  CONTAINED
  INVESTIGATING
  RECOVERING
  RESOLVED
  CLOSED
}

model SecurityIncident {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  title          String
  description    String?
  severity       IncidentSeverity
  status         IncidentStatus   @default(DETECTED)
  detectedAt     DateTime         @default(now())
  reportedByUserId String?        @db.Uuid
  assignedToUserId String?        @db.Uuid
  evidence       Json?
  containmentNotes String?
  resolutionNotes String?
  resolvedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("security_incidents")
}

// ============================================================
// Parte 9 — Domínios 9-11: Administração, Notificações, Relatórios
// ============================================================

enum SubscriptionPlan {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model SaasSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  plan           SubscriptionPlan    @default(BASIC)
  status         SubscriptionStatus  @default(TRIALING)
  monthlyPriceCents Int
  currency       String             @default("AOA")
  planLimits     Json
  startedAt      DateTime
  currentPeriodStart DateTime
  currentPeriodEnd  DateTime
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("saas_subscriptions")
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_CONFIRMED
  TICKETS_ISSUED
  TICKET_TRANSFERRED
  REFUND_PROCESSED
  EVENT_CANCELLED
  EVENT_POSTPONED
  PAYMENT_REMINDER
  ACCESS_ALERT
  SECURITY_ALERT
  SETTLEMENT_READY
  SHIFT_ALERT
  GENERIC
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
}

model Notification {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  orderId        String?           @db.Uuid
  recipientEmail String?
  recipientPhone String?
  recipientUserId String?          @db.Uuid
  channel        NotificationChannel
  type           NotificationType  @default(GENERIC)
  subject        String?
  body           String
  status         DeliveryStatus    @default(PENDING)
  providerRef    String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  attempts       Int               @default(0)
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@index([organizationId, status])
  @@index([orderId])
  @@map("notifications")
}

enum ExportStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model DataExport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  requestedByUserId String    @db.Uuid
  reportType     String
  params         Json
  status         ExportStatus @default(REQUESTED)
  fileUrl        String?
  expiresAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("data_exports")
}

// Rate limiting persistente, partilhado por todas as instâncias da aplicação.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
