generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Parte 1 — Fundação + Domínio 1: Utilizadores e Organizações
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  country    String    @default("AO")
  currency   String    @default("AOA")
  status     OrgStatus @default(ACTIVE)
  createdAt  DateTime  @default(now())

  memberships OrgMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  events      Event[]
  venues      Venue[]
  ticketTypes TicketType[]
  orders      Order[]

  @@map("organizations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  mfaEnabled   Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  memberships OrgMembership[]
  sessions    Session[]
  orders      Order[]

  @@map("users")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  isSystem       Boolean @default(false)
  organizationId String? @db.Uuid

  memberships    OrgMembership[]

  @@unique([name, organizationId])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique // ex: "event:create"
  domain String

  @@map("permissions")
}

model OrgMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  invitedAt      DateTime @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("org_memberships")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  deviceInfo     String?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization?  @relation(fields: [organizationId], references: [id])

  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

// ============================================================
// Parte 2 — Domínio 2: Eventos e Sessões
// ============================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  SOLD_OUT
  POSTPONED
  CANCELLED
  COMPLETED
  CLOSED
}

enum EventCategory {
  CONCERT
  CONFERENCE
  SPORT
  THEATER
  FESTIVAL
  WORKSHOP
  OTHER
}

model Venue {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  address        String?
  city           String?
  country        String  @default("AO")
  capacity       Int?
  mapUrl         String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  seatMaps     SeatMap[]

  @@map("venues")
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  slug           String
  name           String
  description    String?
  category       EventCategory @default(OTHER)
  coverImageUrl  String?
  responsibleUserId String?    @db.Uuid
  status         EventStatus  @default(DRAFT)
  entryRules     String?
  terms          String?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  ticketTypes  TicketType[]

  @@unique([organizationId, slug])
  @@map("events")
}

model EventSession {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  venueId      String?  @db.Uuid
  name         String?
  startsAt     DateTime
  endsAt       DateTime
  doorsOpenAt  DateTime?
  createdAt    DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id])
  venue Venue? @relation(fields: [venueId], references: [id])
  inventory TicketInventory[]
  holds      InventoryHold[]
  orders     Order[]

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

// ============================================================
// Parte 3 — Domínio 3: Bilhetes e Inventário
// ============================================================

enum TicketCategory {
  NORMAL
  VIP
  PREMIUM
  STUDENT
  CHILD
  FREE
  INVITE
  SPECIAL_ACCESS
}

enum TicketTypeStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model TicketType {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @db.Uuid
  organizationId String         @db.Uuid
  name           String
  category       TicketCategory @default(NORMAL)
  description    String?
  basePriceCents Int            @default(0)
  currency       String         @default("AOA")
  rules          Json?
  requiresIdentity Boolean      @default(true)
  status         TicketTypeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event          Event          @relation(fields: [eventId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  batches        TicketBatch[]
  inventory      TicketInventory[]
  holds          InventoryHold[]
  seats          Seat[]
  orderLines     OrderLine[]

  @@index([eventId])
  @@map("ticket_types")
}

enum BatchStatus {
  SCHEDULED
  OPEN
  PAUSED
  CLOSED
  SOLD_OUT
}

model TicketBatch {
  id           String      @id @default(uuid()) @db.Uuid
  ticketTypeId String      @db.Uuid
  name         String
  quantity     Int
  priceCents   Int?
  startsAt     DateTime
  endsAt       DateTime
  maxPerBuyer  Int         @default(10)
  status       BatchStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  inventory  TicketInventory[]

  @@index([ticketTypeId, status])
  @@map("ticket_batches")
}

enum HoldStatus {
  AVAILABLE
  RESERVED
  PENDING_PAYMENT
  VERIFYING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model TicketInventory {
  id           String @id @default(uuid()) @db.Uuid
  sessionId    String @db.Uuid
  ticketTypeId String @db.Uuid
  batchId      String @db.Uuid

  totalQuantity     Int @default(0)
  reservedQuantity  Int @default(0)
  soldQuantity      Int @default(0)

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])
  batch      TicketBatch  @relation(fields: [batchId], references: [id])

  @@unique([sessionId, ticketTypeId, batchId])
  @@map("ticket_inventory")
}

model InventoryHold {
  id           String     @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  sessionId    String     @db.Uuid
  ticketTypeId String     @db.Uuid
  batchId      String     @db.Uuid
  status       HoldStatus @default(RESERVED)
  quantity     Int
  idempotencyKey String?  @unique
  expiresAt    DateTime
  releasedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  session    EventSession @relation(fields: [sessionId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])

  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("inventory_holds")
}

model SeatMap {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  venueId   String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  session EventSession @relation(fields: [sessionId], references: [id])
  venue   Venue        @relation(fields: [venueId], references: [id])
  seats   Seat[]

  @@unique([sessionId, venueId])
  @@map("seat_maps")
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

model Seat {
  id           String     @id @default(uuid()) @db.Uuid
  seatMapId    String     @db.Uuid
  ticketTypeId String?    @db.Uuid
  section      String
  row          String
  label        String
  status       SeatStatus @default(AVAILABLE)
  holdId       String?    @db.Uuid
  expiresAt    DateTime?

  seatMap    SeatMap     @relation(fields: [seatMapId], references: [id])
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  @@unique([seatMapId, section, row, label])
  @@index([seatMapId, status])
  @@map("seats")
}

// ============================================================
// Parte 4 — Domínio 4: Venda e Checkout
// ============================================================

// Estados da encomenda (documentação mestra, Parte 3, secção 1)
enum OrderStatus {
  DRAFT                  // Rascunho
  RESERVED                // Reservada (inventário protegido)
  PENDING_PAYMENT         // Pagamento pendente
  UNDER_REVIEW            // Em análise (ocorrência financeira)
  CONFIRMED               // Venda validada
  PARTIALLY_REFUNDED      // Parcialmente reembolsada
  REFUNDED                // Reembolsada
  CANCELLED               // Cancelada
  EXPIRED                 // Expirada
  DISPUTED                // Em disputa
}

// Origem da venda — cada venda regista a sua origem (doc. mestra, secção 4)
enum SalesChannel {
  MARKETPLACE          // venda online ao público
  ORGANIZER_PRIVATE    // ambiente privado do organizador
  BOX_OFFICE          // bilheteira física
  OTHER               // origens futuras autorizadas
}

// Encomenda: núcleo de conversão da intenção de compra
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  orderNumber    String      @unique // referência humana legível
  buyerUserId    String?     @db.Uuid // comprador autenticado (opcional no marketplace)
  // Dados do comprador (pode não ter conta)
  buyerName      String
  buyerEmail     String
  buyerPhone     String?
  status         OrderStatus @default(DRAFT)
  channel        SalesChannel @default(MARKETPLACE)
  // Valores calculados SEMPRE no servidor (nunca confiáveis do cliente)
  subtotalCents  Int         @default(0)
  discountCents  Int         @default(0)
  serviceFeeCents Int        @default(0)
  taxCents       Int         @default(0)
  commissionCents Int        @default(0) // receita da plataforma
  totalCents     Int         @default(0) // total a pagar
  currency       String      @default("AOA")
  // Idempotência do checkout: uma intenção não gera encomendas duplicadas
  checkoutIdempotencyKey String? @unique
  holdId         String?    @db.Uuid // reserva de inventário associada
  sessionId      String?    @db.Uuid // sessão principal (encomendas mono-sessão no MVP)
  expiresAt      DateTime?  // prazo da reserva
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  buyer        User?        @relation(fields: [buyerUserId], references: [id])
  session      EventSession? @relation(fields: [sessionId], references: [id])
  lines        OrderLine[]
  attendees    OrderAttendee[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("orders")
}

// Linha da encomenda: tipo de bilhete + quantidade + preço unitário aplicado
model OrderLine {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  ticketTypeId String   @db.Uuid
  batchId      String   @db.Uuid
  quantity     Int
  unitPriceCents Int     // preço unitário aplicado (do lote ou base)
  lineSubtotalCents Int
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

// Titular identificado obrigatoriamente (doc. mestra, secção 12):
// comprador ≠ titular; cada bilhete associado a um participante identificado.
// Não é obrigatório criar conta para cada titular.
model OrderAttendee {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  ticketTypeId String   @db.Uuid
  fullName    String   // obrigatório
  email       String?
  phone       String?
  documentType String? // quando exigido (BI, passaporte...)
  documentNumber String? // quando exigido
  extraData   Json?    // apenas quando justificado
  createdAt   DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_attendees")
}
